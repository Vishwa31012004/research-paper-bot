# .env
# ─────────────────────────────────────────────────────────
# Environment variables for Research Paper Bot
# ⚠️  NEVER share this file or push to GitHub!
# ─────────────────────────────────────────────────────────

# Semantic Scholar API key (from Day 2)
# Get free at: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=s2k-x16Go3gz3NHUJ5XQkq7M5zCvHb3rpLlQK6w6z3tp

# HuggingFace API token (NEW - Day 3)
# Get free at: https://huggingface.co/settings/tokens
# Steps:
#   1. Go to https://huggingface.co and create free account
#   2. Click your profile → Settings → Access Tokens
#   3. Click "New token" → name it "research-bot" → role: "read"
#   4. Copy the token and paste it below
HUGGINGFACE_API_TOKEN=

# App settings
DEFAULT_RESULT_LIMIT=10
APP_ENV=development

# Summarization settings
# true  = generate AI summaries (slower but smarter)
# false = skip summaries (faster)
ENABLE_SUMMARIES=true

# Maximum characters of abstract to send for summarization
# Longer = better summary but slower
SUMMARY_MAX_INPUT_LENGTH=1000
